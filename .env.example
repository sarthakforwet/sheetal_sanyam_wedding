# Copy to .env for local development. On Vercel, set these in
# Project → Settings → Environment Variables instead. Never commit .env.
# Everything here is optional.

# Public URL of the site, used in WhatsApp share links and link previews.
# On Vercel it defaults to the project's production domain if unset.
BASE_URL=http://localhost:3000

# AI concierge (the chat button is hidden when unset)
# ANTHROPIC_API_KEY=
# CONCIERGE_MODEL=claude-opus-5-5

# Local server only
PORT=3000

# Demo helper: pretend it's a different time, e.g. 2026-12-04T10:00:00+05:30
# SIMULATE_NOW=
